# Local demo settings; use APP_BUILD=demo when starting/building Vite.
APP_MODE=test
AUTH_MODE=mock
MESSAGING_MODE=mock
APP_ORIGIN=http://localhost:5173

# Runtime public settings belong in the reviewed Worker configuration.
# APP_MODE=production
# APP_STAGE=synthetic-staging
# AUTH_MODE=line
# MESSAGING_MODE=disabled
# APP_ORIGIN=https://YOUR_REVIEWED_HOST
# LINE_CHANNEL_ID=1234567890
# LINE_PROVIDER_ID=1234567891
# LINE_LIFF_ID=1234567890-Example

# Configure server secrets using trusted secret storage, never VITE_ variables:
# RATE_LIMIT_KEY_SECRET (at least 32 random bytes)
# LINE_CHANNEL_SECRET (optional browser OAuth)
# LINE_MESSAGING_ACCESS_TOKEN (Messaging API)
# LINE_MESSAGING_CHANNEL_SECRET (webhook signature verification)
# DENTAL_DB is a reviewed Hyperdrive binding with query caching disabled.

# Database tests require an explicitly disposable local dental_test_* database.
# Supply TEST_DATABASE_URL securely at runtime; no connection string is included.
# Keep notifications and historical one-shot controls disabled until reviewed.
